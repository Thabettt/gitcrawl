  "body": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"csrf-token\" content=\"<redacted>\">\n<title>Filters · gitcrawl</title>\n<script>\n(function () {\n  \"use strict\";\n  try {\n    var stored = window.localStorage.getItem(\"gc-theme\");\n    if (stored === \"light\" || stored === \"dark\") {\n      document.documentElement.setAttribute(\"data-theme\", stored);\n    }\n  } catch (error) {\n    document.documentElement.removeAttribute(\"data-theme\");\n  }\n})();\n</script>\n<link rel=\"stylesheet\" href=\"/static/app.css\">\n<script src=\"/static/htmx.min.js\" defer></script>\n<script src=\"/static/rownav.js\" defer></script>\n<script src=\"/static/applib.js\" defer></script>\n<script src=\"/static/errors.js\" defer></script>\n<script src=\"/static/recentfilters.js\" defer></script>\n<script src=\"/static/modalfocus.js\" defer></script>\n<script src=\"/static/app.js\" defer></script>\n</head>\n<body>\n<a class=\"skip-link\" href=\"#content\">Skip to content</a>\n<div id=\"nav-progress\" class=\"nav-progress\" aria-hidden=\"true\"></div>\n<header class=\"site-header\">\n  <a class=\"brand\" href=\"/\">gitcrawl</a>\n  <nav id=\"main-nav\" class=\"site-nav\" aria-label=\"Primary\">\n    <a href=\"/\">Dashboard</a>\n    <a href=\"/find\">Find</a>\n    <a href=\"/runs\">Runs</a>\n    <a href=\"/filters\">Filters</a>\n  </nav>\n  <button id=\"shortcuts-open\" class=\"button ghost\" type=\"button\" data-open=\"shortcuts-modal\" aria-label=\"Keyboard shortcuts\" title=\"Keyboard shortcuts (?)\">?</button>\n  <button id=\"theme-toggle\" class=\"button ghost\" type=\"button\" aria-pressed=\"false\" aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">Theme</button>\n</header>\n<main id=\"content\" class=\"content\">\n\n<section class=\"panel\">\n  <div class=\"panel-head\">\n    <h1>Saved filters</h1>\n    <a class=\"button primary\" href=\"/find\">Find &amp; save</a>\n  </div>\n  <p class=\"muted\">One-click load into the find form, rename inline, or delete a saved filter.</p>\n  \n  <div class=\"table-wrap\">\n    <table id=\"library-table\" class=\"data-table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">Name</th>\n          <th scope=\"col\">Hash</th>\n          <th scope=\"col\">Created</th>\n          <th scope=\"col\">Last run</th>\n          <th scope=\"col\">Actions</th>\n        </tr>\n      </thead>\n      <tbody id=\"library-body\">\n      \n        <tr id=\"saved-filter-921\" data-filter-id=\"921\" data-filter-hash=\"246aaf4a64819cedf3f4caae4bff42dfe23e6d2e72d26cb83964ecc3e77a6e40\">\n          <td>rust picks</td>\n          <td class=\"mono\"><span title=\"246aaf4a64819cedf3f4caae4bff42dfe23e6d2e72d26cb83964ecc3e77a6e40\">246aaf4a</span></td>\n          <td><relative-time></td>\n          <td>\n            <span class=\"muted\" data-no-run=\"true\">never</span>\n          </td>\n          <td class=\"library-actions\">\n            <a class=\"button ghost\" href=\"/find?filter=921\">Load</a>\n            <form class=\"inline-form\" action=\"/filters/921/rename\" method=\"post\">\n              <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n              <label class=\"sr-only\" for=\"rename-921\">Rename rust picks</label>\n              <input class=\"inline-input\" type=\"text\" id=\"rename-921\" name=\"name\" value=\"rust picks\" aria-label=\"New name for rust picks\">\n              <button class=\"button\" type=\"submit\" aria-label=\"Rename rust picks\">Rename</button>\n            </form>\n            <form class=\"inline-form\" action=\"/filters/921/delete\" method=\"post\" data-delete-filter data-name=\"rust picks\">\n              <input type=\"hidden\" name=\"csrf\" value=\"<redacted>\">\n              <button class=\"button danger\" type=\"submit\" aria-label=\"Delete rust picks\">Delete</button>\n            </form>\n          </td>\n        </tr>\n      \n      </tbody>\n    </table>\n  </div>\n  \n</section>\n\n</main>\n<div id=\"shortcuts-modal\" class=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"shortcuts-title\" hidden>\n  <div class=\"modal-panel\" role=\"document\">\n    <div class=\"panel-head\">\n      <h2 id=\"shortcuts-title\">Keyboard shortcuts</h2>\n      <button id=\"shortcuts-close\" class=\"button ghost\" type=\"button\" data-close=\"shortcuts-modal\" aria-label=\"Close shortcuts\">Close</button>\n    </div>\n    <table class=\"data-table shortcuts-table\">\n      <caption class=\"sr-only\">Keyboard shortcuts</caption>\n      <thead>\n        <tr><th scope=\"col\">Key</th><th scope=\"col\">Action</th></tr>\n      </thead>\n      <tbody>\n        <tr data-shortcut=\"slash\"><td><kbd>/</kbd></td><td>Focus quick search (dashboard)</td></tr>\n        <tr data-shortcut=\"g-h\"><td><kbd>g</kbd> then <kbd>h</kbd></td><td>Go home</td></tr>\n        <tr data-shortcut=\"g-f\"><td><kbd>g</kbd> then <kbd>f</kbd></td><td>Go to Find</td></tr>\n        <tr data-shortcut=\"g-r\"><td><kbd>g</kbd> then <kbd>r</kbd></td><td>Go to Runs</td></tr>\n        <tr data-shortcut=\"g-l\"><td><kbd>g</kbd> then <kbd>l</kbd></td><td>Go to Library (filters)</td></tr>\n        <tr data-shortcut=\"j\"><td><kbd>j</kbd></td><td>Select next row</td></tr>\n        <tr data-shortcut=\"k\"><td><kbd>k</kbd></td><td>Select previous row</td></tr>\n        <tr data-shortcut=\"enter\"><td><kbd>Enter</kbd></td><td>Open selected row</td></tr>\n        <tr data-shortcut=\"escape\"><td><kbd>Esc</kbd></td><td>Close this help or a dialog</td></tr>\n        <tr data-shortcut=\"question\"><td><kbd>?</kbd></td><td>Toggle this help</td></tr>\n      </tbody>\n    </table>\n  </div>\n</div>\n<div id=\"toast\" class=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n</body>\n</html>"
