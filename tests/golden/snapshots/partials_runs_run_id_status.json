  "body": "<div id=\"run-status\" aria-live=\"polite\" data-status=\"done\">\n  <div class=\"run-status-line\">\n    <span id=\"run-status-pill\" class=\"pill done\" data-status=\"done\">Finished</span>\n    <span id=\"run-observation\" class=\"muted\" data-finished-at=\"2026-01-02T00:05:01Z\">observation time 2026-01-02T00:05:01Z</span>\n    <span id=\"run-total\" class=\"muted\" data-total=\"3\">total 3</span>\n    <span id=\"status-loading\" class=\"htmx-indicator muted\" role=\"status\">Updating…</span>\n  </div>\n  <div class=\"run-status-line\" id=\"run-clock-line\" data-started-at=\"2026-01-02T00:00:01Z\" data-finished-at=\"2026-01-02T00:05:01Z\">\n    <span id=\"run-elapsed\" class=\"muted\">elapsed 5m 0s</span>\n    \n  </div>\n  <h2>What happened</h2>\n  <div id=\"run-explained-counts\" class=\"run-counts\">\n    \n    <div class=\"count\" data-count=\"found\">\n      <span class=\"count-value\">Found <strong>3</strong></span>\n      <span class=\"count-explain muted\">Repos GitHub said matched your search.</span>\n    </div>\n    \n    <div class=\"count\" data-count=\"saved\">\n      <span class=\"count-value\">Saved <strong>3</strong></span>\n      <span class=\"count-explain muted\">We fetched each repo’s current details.</span>\n    </div>\n    \n    <div class=\"count\" data-count=\"passed\">\n      <span class=\"count-value\">Passed filters <strong>3</strong></span>\n      <span class=\"count-explain muted\">Also met your file and country rules.</span>\n    </div>\n    \n    <div class=\"count\" data-count=\"unavailable\">\n      <span class=\"count-value\">Unavailable <strong>0</strong></span>\n      <span class=\"count-explain muted\">Deleted or private by the time we looked.</span>\n    </div>\n    \n  </div>\n  \n  \n  <details id=\"run-technical-details\">\n    <summary>Technical details</summary>\n    <div id=\"run-counts\" class=\"run-counts\">\n      <span class=\"count\" data-count=\"fetched\">Found <strong>3</strong></span>\n      <span class=\"count\" data-count=\"inserted\">Saved <strong>3</strong></span>\n      <span class=\"count\" data-count=\"updated\">Saved <strong>0</strong></span>\n      <span class=\"count\" data-count=\"unchanged\">Unchanged <strong>0</strong></span>\n      <span class=\"count\" data-count=\"skipped\">Unavailable <strong>0</strong></span>\n      <span class=\"count\" data-count=\"incomplete\">Incomplete <strong>0</strong></span>\n    </div>\n  </details>\n  <script>\n  (function () {\n    \"use strict\";\n    if (window.__gcRunClock) {\n      clearInterval(window.__gcRunClock);\n      window.__gcRunClock = null;\n    }\n    var clock = document.getElementById(\"run-clock-line\");\n    if (!clock) return;\n    var started = clock.getAttribute(\"data-started-at\");\n    var finished = clock.getAttribute(\"data-finished-at\");\n    if (!started || started === \"—\") return;\n    var startMs = Date.parse(started);\n    if (isNaN(startMs)) return;\n    var endMs = finished && finished !== \"—\" ? Date.parse(finished) : null;\n    var el = document.getElementById(\"run-elapsed\");\n    function fmt(seconds) {\n      if (seconds < 60) return Math.round(seconds) + \"s\";\n      var minutes = Math.floor(seconds / 60);\n      var secs = Math.floor(seconds % 60);\n      if (minutes < 60) return minutes + \"m \" + secs + \"s\";\n      var hours = Math.floor(minutes / 60);\n      return hours + \"h \" + (minutes % 60) + \"m\";\n    }\n    function tick() {\n      var now = endMs || Date.now();\n      var seconds = Math.max(0, (now - startMs) / 1000);\n      if (el) el.textContent = \"elapsed \" + fmt(seconds);\n    }\n    tick();\n    if (!endMs) window.__gcRunClock = setInterval(tick, 1000);\n  })();\n  </script>\n</div>"
}
